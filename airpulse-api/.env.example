APP_ENV=development
APP_NAME=AirPulse API
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
# Runtime environment: development | staging | production
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL via asyncpg)
# ---------------------------------------------------------------------------
# Hosted AirPulse project ref: bbvdujskgbqjhawwgxsa (region ap-south-1)
# Get [YOUR-DB-PASSWORD] from: Supabase Dashboard -> Project Settings -> Database.
#
# DATABASE_URL       : direct connection (session mode, port 5432) for app + workers.
# DATABASE_POOL_URL  : transaction pooler (pgBouncer, port 6543) for high concurrency.
# DATABASE_URL_SYNC  : psycopg2 sync URL used by Alembic migrations.
#
# NEVER expose DATABASE_URL to browser code.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@db.bbvdujskgbqjhawwgxsa.supabase.co:5432/postgres
DATABASE_POOL_URL=postgresql+asyncpg://postgres.bbvdujskgbqjhawwgxsa:CHANGE_ME_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db.bbvdujskgbqjhawwgxsa.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Auth & Keys
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWT_SECRET are BACKEND-ONLY secrets.
# Never expose them to the browser, commit them, or log them.
# Only NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY belong in the frontend.
SUPABASE_URL=https://bbvdujskgbqjhawwgxsa.supabase.co
SUPABASE_PROJECT_REF=bbvdujskgbqjhawwgxsa
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJidmR1anNrZ2Jxamhhd3dneHNhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgzNDcyMzYsImV4cCI6MjEwMzkyMzIzNn0.8M1Bu1t6EIFLuBd9TScdUkaXKFHFf7o956nCCeW3nE0
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY
# JWT secret: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=CHANGE_ME_JWT_SECRET
SUPABASE_JWT_AUD=authenticated
# Leave issuer blank to derive from SUPABASE_URL (<url>/auth/v1)
SUPABASE_JWT_ISSUER=
# Set true in staging/production to strictly verify JWTs (disables demo-token shortcut)
AUTH_STRICT=false

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# File paths
MODEL_DIR=./models
FIXTURES_DIR=./app/collectors/fixtures
LOG_LEVEL=INFO

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# Pipeline & Index Configuration
DEMO_MODE=true
COLLECTION_INTERVAL_HOURS=3
SOURCE_HEALTH_INTERVAL_MINUTES=15
INDEX_BASE_VALUE=100.0
INDEX_BASE_PERIOD=2026-08
INDEX_METHODOLOGY_VERSION=apix-v1.2
ACTIVE_BASKET_VERSION=domestic-basket-2026Q3

# ML & Anomaly Detection Parameters
MODEL_FAREGUARD_VERSION=fareguard-xgb-v1
MODEL_PRICEGUARD_VERSION=priceguard-if-v1
ANOMALY_CONTAMINATION=0.04
ANOMALY_SHAP_THRESHOLD=0.75

# Price Shock Detector Configuration
SHOCK_MIN_PRICE_CHANGE_PCT=20.0
SHOCK_MIN_ROBUST_ZSCORE=3.0
SHOCK_MIN_SOURCE_COUNT=2
SHOCK_MIN_QUOTE_COUNT=10
