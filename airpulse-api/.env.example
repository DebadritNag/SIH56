# ---------------------------------------------------------------------------
# AirPulse Backend — Environment Template
# Copy this file to .env and fill in ALL values marked CHANGE_ME_*
# NEVER commit your real .env — it is git-ignored.
# ---------------------------------------------------------------------------

APP_ENV=development
ENVIRONMENT=development
APP_NAME=AirPulse API
API_V1_PREFIX=/api/v1
PORT=10000
HOST=0.0.0.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL via asyncpg)
# ---------------------------------------------------------------------------
# DATABASE_URL      — direct connection (port 5432), used by the app + workers.
# DATABASE_POOL_URL — transaction pooler (pgBouncer, port 6543), high concurrency.
# DATABASE_URL_SYNC — psycopg2 sync URL for Alembic migrations.
#
# Get DB_PASSWORD from: Supabase Dashboard → Project Settings → Database.
# Replace <PROJECT_REF> with your Supabase project reference (e.g. abcdefghijklmnop).
# NEVER expose any of these URLs to browser code.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME_DB_PASSWORD@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_POOL_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:CHANGE_ME_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL_SYNC=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db.<PROJECT_REF>.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Auth & Keys
# ---------------------------------------------------------------------------
# SERVICE_ROLE_KEY and JWT_SECRET are BACKEND-ONLY — never expose to the browser.
# Get all values from: Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PROJECT_REF=<PROJECT_REF>
SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SERVICE_ROLE_KEY
# JWT Secret: Supabase Dashboard → Project Settings → API → JWT Settings
SUPABASE_JWT_SECRET=CHANGE_ME_JWT_SECRET
SUPABASE_JWT_AUD=authenticated
# Leave blank to derive from SUPABASE_URL (<url>/auth/v1)
SUPABASE_JWT_ISSUER=
# Set true in staging/production (disables the local demo-token shortcut)
AUTH_STRICT=false

# ---------------------------------------------------------------------------
# hCaptcha — bot protection on auth forms
# HCAPTCHA_SECRET is BACKEND-ONLY. Get both values from hcaptcha.com.
# ---------------------------------------------------------------------------
HCAPTCHA_SECRET=CHANGE_ME_HCAPTCHA_SECRET
HCAPTCHA_SITEKEY=CHANGE_ME_HCAPTCHA_SITEKEY
HCAPTCHA_VERIFY_URL=https://api.hcaptcha.com/siteverify
HCAPTCHA_ENABLED=true

# ---------------------------------------------------------------------------
# Redis & Celery
# ---------------------------------------------------------------------------
# Localhost dev: redis://localhost:6379/0
# Docker dev:    redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Crawl4AI — AI-augmented browser scraping
# ---------------------------------------------------------------------------
# Master switch — set true to enable Crawl4AI browser collection.
CRAWL4AI_ENABLED=true
# Max concurrent headless Chromium sessions.
# Keep at 1 on t3.small / 2 GB RAM to avoid OOM alongside uvicorn + Celery.
CRAWL4AI_BROWSER_CONCURRENCY=1
# Hard cap on results per collection run (OTA anti-overload).
CRAWL4AI_DEFAULT_MAX_RESULTS=5

# ---------------------------------------------------------------------------
# Live Scraping (Yatra / HappyFares prototype — disabled by default)
# ---------------------------------------------------------------------------
YATRA_PROTOTYPE_ENABLED=false
YATRA_REVIEW_NOTES=
HAPPYFARES_PROTOTYPE_ENABLED=false
HAPPYFARES_REVIEW_NOTES=
LIVE_WORKER_ENABLED=true
YATRA_BROWSER_HEADLESS=true

# ---------------------------------------------------------------------------
# File Paths
# ---------------------------------------------------------------------------
MODEL_DIR=./models
FIXTURES_DIR=./app/collectors/fixtures

# ---------------------------------------------------------------------------
# CORS & Security
# ---------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://sih-56.vercel.app"]
ALLOWED_HOSTS=["*"]

# ---------------------------------------------------------------------------
# Pipeline & Index Configuration
# ---------------------------------------------------------------------------
DEMO_MODE=true
COLLECTION_INTERVAL_HOURS=3
SOURCE_HEALTH_INTERVAL_MINUTES=15
INDEX_BASE_VALUE=100.0
INDEX_BASE_PERIOD=2026-08
INDEX_METHODOLOGY_VERSION=apix-v1.2
ACTIVE_BASKET_VERSION=domestic-basket-2026Q3

# ---------------------------------------------------------------------------
# ML & Anomaly Detection
# ---------------------------------------------------------------------------
MODEL_FAREGUARD_VERSION=fareguard-xgb-v1
MODEL_PRICEGUARD_VERSION=priceguard-if-v1
ANOMALY_CONTAMINATION=0.04
ANOMALY_SHAP_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Price Shock Detector
# ---------------------------------------------------------------------------
SHOCK_MIN_PRICE_CHANGE_PCT=20.0
SHOCK_MIN_ROBUST_ZSCORE=3.0
SHOCK_MIN_SOURCE_COUNT=2
SHOCK_MIN_QUOTE_COUNT=10
