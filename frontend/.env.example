# AirPulse frontend environment template. Copy to .env.local and fill in.
# Only NEXT_PUBLIC_* variables are exposed to the browser.

# FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/api/v1

# Supabase (browser-safe only — never the service role key or JWT secret)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local dev only: bearer token accepted by FastAPI when AUTH_STRICT=false.
# Leave blank in production (real Supabase JWTs required).
NEXT_PUBLIC_DEV_BEARER_TOKEN=demo-token
