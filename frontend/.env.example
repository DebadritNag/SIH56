# ---------------------------------------------------------------------------
# AirPulse Frontend — Environment Template
# Copy this file to .env.local and fill in ALL values marked CHANGE_ME_*
# NEVER commit your real .env.local — it is git-ignored.
#
# API calls go through the Next.js proxy (/api/proxy/...) which auto-routes:
#   local dev (npm run dev) → tries http://localhost:8000 first, falls back to deployed
#   Vercel / npm run build  → goes directly to NEXT_PUBLIC_API_BASE_URL
# The browser never calls the backend directly — no CORS issues.
# ---------------------------------------------------------------------------

# FastAPI backend URL (used by the server-side proxy).
# For local dev: http://localhost:8000
# For Vercel/production: your deployed EC2 backend URL (e.g. http://54.234.16.107)
NEXT_PUBLIC_API_BASE_URL=CHANGE_ME_BACKEND_URL
NEXT_PUBLIC_API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Supabase — browser-safe values ONLY (auth + optional realtime).
# NEVER put the service role key or JWT secret here.
# Get these from: Supabase Dashboard → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_ANON_KEY

# ---------------------------------------------------------------------------
# Local dev auth shortcut
# Accepted by FastAPI only when AUTH_STRICT=false (never use in production).
# Leave blank in production so real Supabase JWTs are required.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DEV_BEARER_TOKEN=demo-token

# ---------------------------------------------------------------------------
# hCaptcha — public sitekey only (the secret stays on the backend).
# Get from: hcaptcha.com → Sites.
# Leave blank to disable the captcha widget in dev.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HCAPTCHA_SITEKEY=CHANGE_ME_HCAPTCHA_SITEKEY
